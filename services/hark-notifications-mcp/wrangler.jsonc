{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hark-notifications-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "hark-mcp.oeis.ntindle.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
